{
  "name": "springer-discount-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test test/*.test.ts",
    "collect": "tsx src/collector/cli.ts",
    "migrate:series": "tsx src/collector/import-series.ts"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "jspdf": "^4.2.1",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.52.4"
  }
}
