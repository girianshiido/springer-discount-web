# API: conserver ADMIN_TOKEN côté serveur, saisie manuelle dans l'interface.
ADMIN_TOKEN=remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
PORT=8787
# Activer uniquement avec un droit adapté à la collecte Springer.
SPRINGER_COLLECTION_ENABLED=false
COLLECTOR_USER_AGENT=SpringerDiscountFinder/0.1 (+mailto:votre-adresse@example.org)
# Interface construite pour GitHub Pages (aucun secret ici).
VITE_API_URL=http://localhost:8787
